{
    "name": "esoul/guidelines",
    "description": "Layered, mergeable project guidelines for eSoul projects (Laravel, LSR, Astro) with drift detection.",
    "type": "library",
    "license": "MIT",
    "bin": ["bin/esoul-guidelines"],
    "require": {
        "php": "^8.4",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/filesystem": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Esoul\\Guidelines\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Esoul\\Guidelines\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
