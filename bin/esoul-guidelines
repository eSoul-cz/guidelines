#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloaders = [
    __DIR__ . '/../vendor/autoload.php',     // standalone checkout
    __DIR__ . '/../../../autoload.php',      // installed as a dependency: vendor/esoul/guidelines/bin
    __DIR__ . '/../../autoload.php',
];

foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require $autoloader;
        break;
    }
}

if (!class_exists(Esoul\Guidelines\Application::class)) {
    fwrite(STDERR, "Cannot find the Composer autoloader. Run `composer install` first.\n");
    exit(1);
}

exit(new Esoul\Guidelines\Application()->run());
